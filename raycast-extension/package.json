{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "designlang",
  "title": "Designlang",
  "description": "Extract design tokens from any website \u2014 colors, typography, spacing, shadows, shadcn/Tailwind/Figma outputs.",
  "icon": "icon.png",
  "author": "masyv",
  "license": "MIT",
  "categories": [
    "Design Tools",
    "Developer Tools"
  ],
  "keywords": [
    "design",
    "tokens",
    "css",
    "tailwind",
    "figma",
    "shadcn"
  ],
  "commands": [
    {
      "name": "extract",
      "title": "Extract Design From URL",
      "description": "Run designlang on a URL and open the output folder.",
      "mode": "view"
    },
    {
      "name": "score",
      "title": "Score Website Design",
      "description": "Rate a site's design-system quality (7 categories, A\u2013F).",
      "mode": "view"
    },
    {
      "name": "copy-cli",
      "title": "Copy CLI Command For URL",
      "description": "Copy `designlang <url>` to your clipboard.",
      "mode": "no-view",
      "arguments": [
        {
          "name": "url",
          "placeholder": "https://stripe.com",
          "type": "text",
          "required": true
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "outputDir",
      "type": "textfield",
      "title": "Output directory",
      "description": "Where extracted files are written.",
      "default": "~/designlang-output",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "1.104.25"
  },
  "devDependencies": {
    "@raycast/eslint-config": "1.0.11",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "eslint": "8.57.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.7"
    },
    "@raycast/api": {
      "esbuild": "0.28.1"
    }
  }
}
